{
  "name": "python-playground",
  "version": "1.0.3",
  "description": "DivergePython: Python até PySpark no navegador, com dados em paralelo e acessibilidade para pessoas cegas, surdas e neurodivergentes",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun --collect.settings.chromeFlags=\"--no-sandbox\" --upload.target=filesystem --upload.outputDir=.lighthouseci",
    "badges": "node scripts/gerar-badges.mjs",
    "lint": "eslint ."
  },
  "type": "module",
  "dependencies": {
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@noble/ed25519": "2.3.0",
    "@noble/hashes": "1.8.0",
    "codemirror": "^6.0.2",
    "pyodide": "314.0.7",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.5"
  },
  "private": true,
  "license": "AGPL-3.0-or-later"
}
